{
  "name": "douyin-search",
  "description": "抖音作品查询工具。根据关键词搜索抖音热门爆款作品，支持按日期范围筛选",
  "inputSchema": {
    "type": "object",
    "properties": {
      "keyword": {
        "type": "string",
        "description": "搜索关键词，空字符串查询全站热门"
      },
      "startDate": {
        "type": "string",
        "description": "起始日期 YYYY-MM-DD"
      },
      "endDate": {
        "type": "string",
        "description": "结束日期 YYYY-MM-DD"
      },
      "pageNum": {
        "type": "number",
        "description": "页码",
        "default": 1
      },
      "pageSize": {
        "type": "number",
        "description": "每页数量（最大50）",
        "default": 50
      }
    },
    "required": [
      "keyword"
    ]
  }
}