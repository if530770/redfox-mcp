{
  "name": "xiaohongshu-cover",
  "description": "小红书爆款封面设计参考，查询同赛道爆款笔记获取封面视觉规律",
  "inputSchema": {
    "type": "object",
    "properties": {
      "keyword": {
        "type": "string",
        "description": "赛道关键词"
      },
      "startDate": {
        "type": "string",
        "description": "起始日期 YYYY-MM-DD"
      },
      "maxItems": {
        "type": "number",
        "description": "返回数量",
        "default": 10
      }
    },
    "required": [
      "keyword"
    ]
  }
}