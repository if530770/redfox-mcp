{
  "name": "cn-last30days",
  "description": "全网多平台近30天内容搜索，按关键词跨平台查询爆款内容",
  "inputSchema": {
    "type": "object",
    "properties": {
      "keyword": {
        "type": "string",
        "description": "搜索关键词"
      },
      "platforms": {
        "type": "string",
        "description": "平台列表（逗号分隔），如 douyin,xiaohongshu,gongzhonghao"
      },
      "startDate": {
        "type": "string",
        "description": "起始日期 YYYY-MM-DD"
      },
      "endDate": {
        "type": "string",
        "description": "结束日期 YYYY-MM-DD"
      }
    },
    "required": [
      "keyword"
    ]
  }
}