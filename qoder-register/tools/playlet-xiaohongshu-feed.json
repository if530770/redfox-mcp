      "msgType": {
        "type": "string",
        "description": "msgType"
      },
      "platform": {
        "type": "string",
        "description": "platform"
      },
      "pageNum": {
        "type": "number",
        "description": "pageNum"
      },
      "pageSize": {
        "type": "number",
        "description": "pageSize"
      },
      "startTime": {
        "type": "string",
        "description": "startTime"
      },
      "endTime": {
        "type": "string",
        "description": "endTime"
      },
      "timestamp": {
        "type": "string",
        "description": "timestamp"
      },
      "no_data": {
        "type": "string",
        "description": "no_data"
      },
      "keyword_no_match": {
        "type": "string",
        "description": "keyword_no_match"
      },
      "api_error": {
        "type": "string",
        "description": "api_error"
      }
    }
  }
}