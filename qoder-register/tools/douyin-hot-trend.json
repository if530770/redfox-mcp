{
  "name": "douyin-hot-trend",
  "description": "抖音热点趋势查询，按平台获取热门话题列表",
  "inputSchema": {
    "type": "object",
    "properties": {
      "platform": {
        "type": "string",
        "description": "平台：douyin/xiaohongshu/gongzhonghao 等",
        "default": "douyin"
      },
      "startDate": {
        "type": "string",
        "description": "起始日期 YYYY-MM-DD"
      },
      "endDate": {
        "type": "string",
        "description": "结束日期 YYYY-MM-DD"
      }
    }
  }
}