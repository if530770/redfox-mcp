{
  "name": "video-prompt-expert",
  "description": "帮助用户编写专业级 AI 视频提示词，写完直接生成 MP4 视频。支持多种创作场景与问题诊断，确保提示词准确可执行。触发词：视频提示词、视频生成提示词、AI视频创作、写视频提示词、导演指令、文生视频提示词、视频脚本、生成视频",
  "inputSchema": {
    "type": "object",
    "properties": {
      "content": {
        "type": "string",
        "description": "content"
      },
      "model": {
        "type": "string",
        "description": "model"
      },
      "resolution": {
        "type": "string",
        "description": "resolution"
      },
      "ratio": {
        "type": "string",
        "description": "ratio"
      },
      "duration": {
        "type": "number",
        "description": "duration"
      },
      "seed": {
        "type": "number",
        "description": "seed"
      },
      "watermark": {
        "type": "string",
        "description": "watermark"
      },
      "generateAudio": {
        "type": "string",
        "description": "generateAudio"
      },
      "returnLastFrame": {
        "type": "string",
        "description": "returnLastFrame"
      },
      "executionExpiresAfter": {
        "type": "string",
        "description": "executionExpiresAfter"
      }
    }
  }
}