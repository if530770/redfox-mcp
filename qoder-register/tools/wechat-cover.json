{
  "name": "wechat-cover",
  "description": "公众号爆款封面参考，查询同赛道爆款文章获取封面设计参考",
  "inputSchema": {
    "type": "object",
    "properties": {
      "keyword": {
        "type": "string",
        "description": "赛道关键词"
      },
      "startDate": {
        "type": "string",
        "description": "起始日期 YYYY-MM-DD"
      },
      "maxItems": {
        "type": "number",
        "description": "返回数量",
        "default": 10
      }
    },
    "required": [
      "keyword"
    ]
  }
}